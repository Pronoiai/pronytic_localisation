use crate::{LocalisationDetails,LocalisationText,Token};

grammar;

extern {
    type Location = usize;
    type Error = String;

    enum Token {
        "string" => Token::String(<String>),
        "=" => Token::Equal,
        "\"" => Token::Quote,
        "," => Token::Comma,
        "{" => Token::OpeningCurly,
        "}" => Token::ClosingCurly,
        "[" => Token::OpeningSquare,
        "]" => Token::ClosingSquare,
        "Goto" => Token::Goto,
        "Highlight" => Token::Highlight,
        "Term" => Token::Term,
        "Text" => Token::Text,
    }
}

pub LocalisationText:Vec<LocalisationText> = {
    TextPart*
}

TextPart:LocalisationText = {
    <s:"string"> => LocalisationText::String(s),
    <","> => LocalisationText::String(",".to_string()),
    "{" <c:CommandText> "}" => c,
    "Goto" => LocalisationText::String("Goto".to_string()),
    "Highlight" => LocalisationText::String("Highlight".to_string()),
    "Term" => LocalisationText::String("Term".to_string()),
    "{" "}" => LocalisationText::Parameter,
}

CommandText:LocalisationText = {
    "Goto" "[" <link:"string"> "," "Text" "=" "\"" <text:"string"> "\"" "]" => LocalisationText::Goto(LocalisationDetails{
        link,
        text,
    }),
    "Goto" "[" <link:"string"> "]" =>LocalisationText::Goto(LocalisationDetails{
        text:link.clone(),
        link,
    }),
    "Highlight" "[" <link:"string"> "," "Text" "=" "\"" <text:"string"> "\"" "]" => LocalisationText::Highlight(LocalisationDetails{
        link,
        text,
    }),
    "Highlight" "[" <link:"string"> "]" => LocalisationText::Highlight(LocalisationDetails{
        text:link.clone(),
        link,
    }),
    "Term" "[" <link:"string"> "," "Text" "=" "\"" <text:"string"> "\"" "]" => LocalisationText::Link(LocalisationDetails{
        link,
        text,
    }),
    "Term" "[" <link:"string"> "]" => LocalisationText::Link(LocalisationDetails{
        text:link.clone(),
        link,
    }),
}
